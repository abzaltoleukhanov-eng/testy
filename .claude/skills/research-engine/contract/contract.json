  "counting_rules": {
    "usable_access_status": [
      "READ_FULL",
      "READ_PARTIAL"
    ],
    "unusable_retrieval_without_recheck": [
      "SEARCH_SNIPPET",
      "EXTRACTOR"
    ],
    "independence_key": "evidence.independence_group if set and not UNKNOWN, otherwise 'thread:' + source.thread_id. Comments in one thread are one group unless the analyst records why a story is independent.",
    "decision_actions": [
      "BOUGHT",
      "REJECTED",
      "RETURNED",
      "SWITCHED",
      "STOPPED_USING",
      "POSTPONED"
    ],
    "situation_key": "evidence.situation_cluster_id (consolidated clusters); the author's raw label is kept in situation_label_raw. usage_situation is free text and is not counted."
  },
  "gates": {
    "PERSONAL_EXPERIENCE": {
      "min_groups": 1,
      "min_threads": 1,
      "counter_search_required": false
    },
    "PATTERN": {
      "min_groups": 3,
      "min_threads": 2,
      "min_platforms_or_situations": 2,
      "counter_search_required": true
    },
    "PURCHASE_DRIVER": {
      "min_groups": 2,
      "min_threads": 2,
      "min_decision_groups": 2,
      "counter_search_required": true
    },
    "PRODUCT_FACT": {
      "requires_exact_sku": true,
      "allowed_origin": [
        "official source READ_FULL",
        "USER_UPLOAD",
        "SCREENSHOT"
      ]
    },
    "PRODUCT_PERFORMANCE": {
      "min_groups": 1,
      "allowed_product_match": [
        "EXACT_SKU",
        "SAME_PRODUCT_FAMILY"
      ],
      "counter_search_required": true
    },
    "SITUATION_REACH": {
      "max_status": "HYPOTHESIS_UNTESTED",
      "requires_audit": true,
      "note": "Corpus frequency never establishes reach. Passes only as an audited forward-looking proxy hypothesis."
    },
    "CREATIVE_PERFORMANCE": {
      "max_status": "BLOCKED",
      "note": "Needs own campaign data; not supported in research MVP."
    },
    "HYPOTHESIS": {
      "max_status": "HYPOTHESIS_UNTESTED",
      "requires": [
        "hypothesis_label"
      ],
      "requires_audit": true,
      "note": "A label never bypasses the audit: an auditor must confirm the text is forward-looking and does not assert unobserved facts (existing results, video content, audience size or share, current trends)."
    }
  },
  "final_status_rule": "FACT_APPROVED = schema valid + evidence sufficiency for the claim type + independent audit SUPPORTS with verbatim spans + no scope issue or open contradiction. HYPOTHESIS_UNTESTED / RESEARCH_QUESTION per class_rules.premise_rule. BLOCKED = contradicted, asserts an unobserved fact, or unsupported type. Otherwise NEEDS_REVIEW. ACH is VALID only if its pattern claim is FACT_APPROVED, otherwise PRELIMINARY. The model never writes a status; validate.py computes it.",
  "saturation": {
    "novelty_window": 20,
    "branch_closed_requires_polarity": [
      "NEUTRAL",
      "POSITIVE"
    ],
    "coverage_dimensions": [
      "journey_stage",
      "scope",
      "market"
    ],
    "note": "Saturation means enough for the current research question, not that the market is studied. Blocked sources or unsearched markets make the run COVERAGE_LIMITED."
  },
  "changelog": [
    {
      "version": "0.3",
      "date": "2026-10-17",
      "change": "Hypothesis label no longer bypasses substantive audit (found by ChatGPT blind benchmark v02: G14, G20, G22). Status HYPOTHESIS_LABELED renamed HYPOTHESIS_UNTESTED."
    },
    {
      "version": "0.4",
      "date": "2026-10-17",
      "change": "Premise audit for hypotheses (holdout H18), RESEARCH_QUESTION status, claim classes, computed CORPUS_STATISTIC, ACH validity, derived-statement and consistency checks for briefs. APPROVED renamed FACT_APPROVED; CONTRADICTED folded into BLOCKED."
    }
  ],
  "class_rules": {
    "legacy_class_by_type": {
      "PERSONAL_EXPERIENCE": "SOURCE_REPORT",
      "PATTERN": "SOURCE_REPORT",
      "PURCHASE_DRIVER": "SOURCE_REPORT",
      "PRODUCT_FACT": "OBSERVED_STATE",
      "PRODUCT_PERFORMANCE": "WORLD_CLAIM",
      "SITUATION_REACH": "FUTURE_HYPOTHESIS",
      "CREATIVE_PERFORMANCE": "WORLD_CLAIM",
      "HYPOTHESIS": "FUTURE_HYPOTHESIS"
    },
    "hypothesis_classes": [
      "CAUSAL_HYPOTHESIS",
      "FUTURE_HYPOTHESIS"
    ],
    "premise_rule": "A hypothesis passes as HYPOTHESIS_UNTESTED only if (1) the audit says FORWARD_LOOKING_OK, (2) every premise_claim_id is FACT_APPROVED, (3) the auditor lists no uncovered factual premise, (4) link_check is PLAUSIBLE_UNTESTED. A hypothesis status never raises the evidence level of its premises. Failing (2)-(4) gives RESEARCH_QUESTION: kept as a question to investigate, never used as a finding.",
    "corpus_statistic_rule": "CORPUS_STATISTIC is recomputed from the ledger: unit, numerator evidence ids, denominator query ids. Numbers in the text must equal the recomputed ones, the text must name the corpus, and a corpus built mostly from PROBLEM queries needs a bias_note. It never measures a population."
  }
}
